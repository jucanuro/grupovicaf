# Copiar a .env y completar valores. Nunca versionar .env con valores reales.

# --- Django ---
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# --- Rol del sitio: 'lab' (LIMS) o 'web' (institucional pública) ---
SITE_ROLE=
SITE_URL=

# --- Seguridad (producción) ---
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_HSTS_SECONDS=

# --- Base de datos (PostgreSQL, producción) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Redis / Celery ---
REDIS_URL=
# Opcionales: solo si el broker/backend de Celery debe ser un Redis distinto
# del de CACHES. Por defecto ambos reusan REDIS_URL.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Docker dev: puerto del host para 'lab' si el 8000 ya está ocupado ---
LAB_HOST_PORT=

# --- Email ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=
