# Copiar a .env y completar valores. Nunca versionar .env con valores reales.

# --- Django ---
SECRET_KEY=
DEBUG=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# --- Rol del sitio: 'lab' (LIMS) o 'web' (institucional pública) ---
SITE_ROLE=
SITE_URL=

# --- Seguridad (producción) ---
SECURE_SSL_REDIRECT=
SESSION_COOKIE_SECURE=
CSRF_COOKIE_SECURE=
SECURE_HSTS_SECONDS=

# --- Base de datos (PostgreSQL, producción) ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Redis / Celery ---
# El cache usa REDIS_URL tal cual (por convención, DB 0). El broker y el
# backend de Celery usan la MISMA instancia pero en la DB 1, para que un
# FLUSHDB del cache no borre la cola de tareas.
REDIS_URL=
# Opcionales: solo si el broker/backend debe apuntar a otro Redis. Si se dejan
# vacíos se derivan de REDIS_URL cambiando el número de base a 1.
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Docker dev: puerto del host para 'lab' si el 8000 ya está ocupado ---
LAB_HOST_PORT=

# --- Email ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# --- Módulo de correo (app correo) ---
# Host del correo y del LIMS. Vacíos: email.localhost / localhost en dev,
# email.grupovicaf.com / laboratorio.grupovicaf.com en prod.
CORREO_HOST=
LAB_HOST=
# URLs base absolutas (https://email.grupovicaf.com). Vacías: se arman con el
# esquema y puerto de la petición (dev) o con https://<host> (prod).
CORREO_BASE_URL=
LAB_BASE_URL=
# Vigencia en segundos del enlace firmado laboratorio -> correo (60).
CORREO_ENLACE_SEGUNDOS=
# True: si el usuario solo tiene un módulo, salta la pantalla de entrada.
CORREO_OMITIR_ENTRADA=
# Archivos del correo: 'local' (por defecto) o 'r2' (producción).
CORREO_ALMACEN=
# Modo local: carpeta privada fuera de MEDIA_ROOT (nginx nunca la sirve).
# Vacía: <proyecto>/correo_privado.
CORREO_ALMACEN_DIR=
# Modo r2: bucket privado, endpoint https://<id-cuenta>.r2.cloudflarestorage.com
# y token de API de R2 (Object Read & Write) limitado a ese bucket.
CORREO_R2_BUCKET=
CORREO_R2_ENDPOINT=
CORREO_R2_ACCESS_KEY=
CORREO_R2_SECRET_KEY=
# Dominios permitidos al crear cuentas (coma). Vacío: grupovicaf.com
CORREO_DOMINIOS=
# Vigencia en segundos de los enlaces firmados de adjuntos (300).
CORREO_URL_FIRMADA_SEGUNDOS=
# Envío: 'simulado' (por defecto) o 'smtp'. docker-compose.dev.yml ya usa smtp
# contra Mailpit; en producción será el SMTP de Amazon SES (Paso 5).
CORREO_ENVIO=
CORREO_SMTP_HOST=
CORREO_SMTP_PUERTO=
CORREO_SMTP_USUARIO=
CORREO_SMTP_CLAVE=
CORREO_SMTP_TLS=
# Solo desarrollo: API de Mailpit para traer lo que llega a las cuentas VICAF.
CORREO_MAILPIT_URL=
