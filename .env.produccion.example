# Claves nuevas a AÑADIR al .env que ya existe en el servidor
# (/var/www/projects/grupovicaf/.env) para el despliegue del rol 'web' y
# Redis/Celery. No borres lo que ya está ahí (SECRET_KEY, DB_*, EMAIL_*):
# esas siguen igual, la base de datos de producción no se toca.
#
# Copiar solo las líneas de abajo al final del .env real y completar valores.

# --- Rol del sitio ---
# El valor de aquí solo importa para comandos manuales de manage.py
# (migrate, shell, etc.). Los servicios systemd (deploy/systemd/) fijan
# SITE_ROLE y SITE_URL por proceso — vicaflab.service usa 'lab', vicafweb.
# service usa 'web' — y esos pisan lo que haya aquí, no lo mezcles a mano.
SITE_ROLE=lab
SITE_URL=https://laboratorio.grupovicaf.com

# --- Hosts ampliados a los 3 dominios (antes solo tenía laboratorio) ---
ALLOWED_HOSTS=laboratorio.grupovicaf.com,grupovicaf.com,www.grupovicaf.com,35.153.197.74
CSRF_TRUSTED_ORIGINS=https://laboratorio.grupovicaf.com,https://grupovicaf.com,https://www.grupovicaf.com

# --- SEO: noindex global del rol 'web' mientras el contenido no esté listo ---
# En True: todas las páginas públicas emiten noindex,nofollow y robots.txt
# devuelve Disallow: /, sin importar el noindex de cada página/línea/zona.
# Cambiar a False cuando el contenido esté redactado y se quiera indexar
# (regla 16 de CLAUDE.md: nunca quitarlo con contenido de doorway page sin
# redactar de verdad).
SITE_NOINDEX=True

# --- Redis / Celery (instancia nativa en el mismo EC2, ver INSTRUCTIVO) ---
# El cache usa REDIS_URL tal cual (DB 0). Broker/backend de Celery se
# derivan solos a la DB 1 de la misma instancia si se dejan vacíos.
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# --- Seguridad HTTPS (nginx ya termina TLS y manda X-Forwarded-Proto) ---
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=0
